{
  "manifest_version": 3,
  "name": "UMC Bell System v21",
  "version": "1.0.21",
  "description": "UMC Bell background scheduler with persistent login, explicit extension logout only, safe cross-tab sync, schedule/audio sync, emergency stop, online status and movable floating status bar.",
  "permissions": [
    "alarms",
    "storage",
    "offscreen",
    "notifications",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "UMC Bell System",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {}
}
