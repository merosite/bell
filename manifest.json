{
  "manifest_version": 3,
  "name": "UMC Bell System v24",
  "version": "1.0.24",
  "description": "Stable UMC Bell background scheduler with persistent login, safe manual audio, live app status, countdown and reliable app-extension sync.",
  "permissions": [
    "alarms",
    "storage",
    "offscreen",
    "notifications",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "UMC Bell System",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {}
}